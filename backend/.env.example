# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym_blockchain
DB_USER=gym_user
DB_PASSWORD=gym_password

# Geth Dev 本地开发链
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=1337

# 合约部署账户私钥（本地 Geth Dev 账户，禁止提交真实私钥）
DEPLOYER_PRIVATE_KEY=0x_your_geth_dev_private_key

# Pinata IPFS 配置（用于管理员预上传徽章元数据）
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# 服务钱包（后端用于调用合约铸造 NFT、发放奖励）
SERVICE_WALLET_PRIVATE_KEY=0x_your_service_wallet_private_key

# 智能合约地址（部署后自动输出，手动填入）
FITTOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
MEMBERSHIP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHECKIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ACHIEVEMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
# 后端服务
PORT=3001
JWT_SECRET=your_jwt_secret
