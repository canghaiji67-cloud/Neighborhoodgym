{
  "name": "gym-blockchain-backend",
  "version": "1.0.0",
  "description": "Backend for blockchain gym membership & achievement system",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "migrate": "sequelize-cli db:migrate",
